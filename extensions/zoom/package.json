{
  "name": "@openclaw/zoom",
  "version": "2026.2.10",
  "private": true,
  "description": "OpenClaw Zoom meetings tool plugin",
  "type": "module",
  "dependencies": {
    "@sinclair/typebox": "0.34.48"
  },
  "devDependencies": {
    "openclaw": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/zoom",
      "localPath": "extensions/zoom",
      "defaultChoice": "local"
    }
  }
}
