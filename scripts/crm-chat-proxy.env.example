# Public URL of your OpenClaw gateway
OPENCLAW_URL=https://your-openclaw-gateway.example.com

# Gateway auth token (gateway.auth.token)
OPENCLAW_TOKEN=replace-with-openclaw-token

# Optional: default agent and model
OPENCLAW_AGENT_ID=main
OPENCLAW_MODEL=openclaw:main

# Required for protecting your CRM endpoint
CRM_CHAT_API_KEY=replace-with-strong-random-key

# Optional runtime tuning
OPENCLAW_TIMEOUT_MS=25000
OPENCLAW_SESSION_PREFIX=crm
CORS_ORIGIN=https://fxinmobilia.com
OPENCLAW_SYSTEM_PROMPT=Eres un asesor de consulta CRM claro y preciso.

# Heroku provides PORT automatically
# PORT=8789
